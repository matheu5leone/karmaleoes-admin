# =============================================================================
# Variáveis do stack LOCAL em Docker (docker-compose). Copie para `.env.docker`.
# -----------------------------------------------------------------------------
# Lógica de ambientes:
#   LOCAL      = Docker (este arquivo / .env.docker)
#   PRODUÇÃO   = Vercel NATIVO (variáveis configuradas no painel da Vercel)
# Supabase é REMOTO (projeto hospedado) em ambos. Redis é LOCAL em container.
# =============================================================================

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Supabase (projeto remoto/hospedado) — Dashboard → Project Settings → API ---
NEXT_PUBLIC_SUPABASE_URL="https://huahobdsrjvsbjbllclz.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Redis (LOCAL via container) ---
# redis-http é o shim REST (Upstash-compatível). Hostname = nome do serviço no compose.
# O token deve casar com SRH_TOKEN do serviço redis-http (docker-compose.yml).
UPSTASH_REDIS_REST_URL="http://redis-http:80"
UPSTASH_REDIS_REST_TOKEN="local_dev_token"

# --- Sessão / Eventos ---
SESSION_INACTIVITY_TIMEOUT_SECONDS="1800"
APP_TIMEZONE="America/Sao_Paulo"

# --- Seed do 1º admin (opcional em dev) ---
SEED_ADMIN_EMAIL="admin@karmaleoes.com"
SEED_ADMIN_TEMP_PASSWORD=""
