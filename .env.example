# =============================================================================
# Portal Administrativo Karmaleões — variáveis de ambiente (EXEMPLO)
# -----------------------------------------------------------------------------
# Copie para `.env.local` (dev) e preencha com valores reais. NUNCA commitar o
# `.env.local`. Variáveis com prefixo NEXT_PUBLIC_ são expostas ao browser;
# todas as demais são SERVER-ONLY (nunca devem vazar para o client).
# Stack: Next.js (App Router) + Supabase (Postgres/Auth/Storage) + Redis (Upstash).
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------
# URL pública da aplicação. Usada em redirects de auth (recuperação de senha,
# confirmação por e-mail). Em produção, a URL do deploy na Vercel.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Supabase — Postgres + Auth + Storage
# (Dashboard: Project Settings → API)
# -----------------------------------------------------------------------------
# URL do projeto Supabase (pública).
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"

# Chave anônima (pública) — usada no client e no server-SSR com RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Chave service-role (SERVER-ONLY) — ignora RLS. Usar apenas no server
# (lib/supabase/admin.ts): seed, operações administrativas controladas.
# NUNCA expor ao browser.
SUPABASE_SERVICE_ROLE_KEY=""

# -----------------------------------------------------------------------------
# Supabase CLI — migrations e ambiente local
# (necessário para `supabase db push` / `supabase link`)
# -----------------------------------------------------------------------------
# Token de acesso pessoal do Supabase CLI (Dashboard → Account → Access Tokens).
SUPABASE_ACCESS_TOKEN=""

# Project ref do Supabase (parte do subdomínio: <project-ref>.supabase.co).
SUPABASE_PROJECT_REF=""

# Senha do banco Postgres do projeto (para migrations via CLI).
SUPABASE_DB_PASSWORD=""

# String de conexão direta com o Postgres (opcional — scripts/migrations diretas).
# Ex.: postgresql://postgres:[senha]@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=""

# -----------------------------------------------------------------------------
# Redis (Upstash) — sessão única + timeout de inatividade
# (Upstash Console → Database → REST API)
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Timeout de inatividade da sessão, em segundos (TTL renovável no Redis).
# LACUNA: valor a definir pelo time (ver transversal-totp-e-sessao.md). Ex.: 1800 = 30min.
SESSION_INACTIVITY_TIMEOUT_SECONDS="1800"

# -----------------------------------------------------------------------------
# Eventos — cálculo de expiração (campos virtuais)
# -----------------------------------------------------------------------------
# Fuso horário usado para comparar a data corrente com a data de referência na
# view `eventos_view`. LACUNA: a definir pelo time (ver 04-eventos.md). Ex.: America/Sao_Paulo.
APP_TIMEZONE="America/Sao_Paulo"

# -----------------------------------------------------------------------------
# Seed do primeiro usuário administrativo (RN-LOGIN-006)
# Usado por `supabase/seed.sql` / script de seed na implantação. Sem auto-registro.
# -----------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@karmaleoes.com"

# Senha temporária do 1º admin (trocada + enroll TOTP no 1º acesso).
SEED_ADMIN_TEMP_PASSWORD=""

# -----------------------------------------------------------------------------
# E-mail transacional (recuperação de senha / confirmações)
# -----------------------------------------------------------------------------
# Por padrão usa o e-mail nativo do Supabase Auth (configurado no Dashboard:
# Authentication → Emails / SMTP). Nenhuma variável de app é obrigatória aqui.
# Caso futuramente se configure SMTP próprio, documentar as credenciais abaixo.
# SMTP_HOST=""
# SMTP_PORT=""
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM=""
